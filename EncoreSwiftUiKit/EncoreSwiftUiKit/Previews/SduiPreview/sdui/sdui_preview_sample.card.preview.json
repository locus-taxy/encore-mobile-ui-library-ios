{
  "templates": {},
  "card": {
    "log_id": "notification_dialog_v1",
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "width": { "type": "match_parent" },
          "paddings": { "top": 20, "bottom": 20, "left": 20, "right": 20 },
          "items": [
            {
              "type": "text",
              "text": "@{title}",
              "font_size": 18,
              "font_weight": "bold",
              "text_color": "#141414"
            },
            {
              "type": "text",
              "text": "@{message}",
              "font_size": 14,
              "text_color": "#5C5C5C",
              "margins": { "top": 8 }
            },
            {
              "type": "text",
              "text": "@{count} unread",
              "font_size": 12,
              "text_color": "#0F7C78",
              "margins": { "top": 12 },
              "visibility": "@{count > 0 ? 'visible' : 'gone'}"
            }
          ]
        }
      }
    ],
    "variables": [
      { "name": "title", "type": "string", "value": "3 urgent notifications" },
      {
        "name": "message",
        "type": "string",
        "value": "Trip LMT-2847 was reassigned and two stops changed time."
      },
      { "name": "count", "type": "integer", "value": 3 }
    ]
  }
}
